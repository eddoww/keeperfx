# Cloudflare Pages response headers (also understood by Netlify).
# Game data is requested as <path>?v=<content hash>, so a changed file always
# gets a new URL and can be cached for good; the manifest names those hashes
# and must stay fresh.
/gamedata/*
  Cache-Control: public, max-age=31536000, immutable

/gamedata/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

# The service worker must never be cached for long: a new deploy reaches
# players through it (web/sw.js). The page itself is revalidated too.
/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
