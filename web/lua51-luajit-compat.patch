+/* \u{XXX}: a code point written as UTF-8, up to 0x10FFFF (LuaJIT / Lua 5.3) */
+static void utf8esc (LexState *ls) {
+  unsigned long r;
+  int i = 0;
+  next(ls);  /* skip 'u' */
+  if (ls->current != '{')
+    luaX_lexerror(ls, "missing '{' in \\u{xxxx}", TK_STRING);
+  r = gethexa(ls);
+  next(ls);
+  while (isxdigit(ls->current)) {
+    r = (r << 4) + (isdigit(ls->current) ? ls->current - '0'
+                                        : (tolower(ls->current) - 'a') + 10);
+    if (r >= 0x110000UL)
+      luaX_lexerror(ls, "UTF-8 value too large", TK_STRING);
+    next(ls);
+  }
+  if (ls->current != '}')
+    luaX_lexerror(ls, "missing '}' in \\u{xxxx}", TK_STRING);
+  next(ls);  /* skip '}' */
+  if (r < 0x80)
+    save(ls, (int)r);
+  else {
+    char buff[8];
+    unsigned long mfb = 0x3f;  /* maximum that fits in first byte */
+    do {
+      buff[7 - i++] = (char)(0x80 | (r & 0x3f));
+      r >>= 6;
+      mfb >>= 1;
+    } while (r > mfb);
+    buff[7 - i] = (char)((~mfb << 1) | r);  /* first byte */
+    for (; i >= 0; i--)
+      save(ls, (unsigned char)buff[7 - i]);
+  }
+}
