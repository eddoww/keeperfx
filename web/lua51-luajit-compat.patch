+static int gethexa (LexState *ls) {
+  next(ls);
+  if (!isxdigit(ls->current))
+    luaX_lexerror(ls, "hexadecimal digit expected", TK_STRING);
+  return isdigit(ls->current) ? ls->current - '0'
+                              : (tolower(ls->current) - 'a') + 10;
+}
+
+
+/* \xXX: exactly two hexadecimal digits (LuaJIT / Lua 5.2) */
+static int readhexaesc (LexState *ls) {
+  int r = gethexa(ls);
+  return (r << 4) + gethexa(ls);
+}
+
