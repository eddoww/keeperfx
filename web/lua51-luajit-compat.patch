+/*
+** LuaJIT's math.random: a Tausworthe PRNG with period 2^223 (L'Ecuyer 1991,
+** table 3, 1st entry), with LuaJIT's seeding and range mapping, so a seed
+** gives the same sequence as desktop KeeperFX. Each Lua state has its own
+** generator (an upvalue), not C rand() shared with the rest of the program.
+*/
+typedef struct PRNGState { uint64_t u[4]; } PRNGState;
+typedef union { uint64_t u64; double d; } U64double;
+
+#define TW223_GEN(rs, z, r, i, k, q, s) \
+  z = rs->u[i]; \
+  z = (((z<<q)^z) >> (k-s)) ^ ((z&((uint64_t)(int64_t)-1 << (64-k)))<<s); \
+  r ^= z; rs->u[i] = z;
+
+#define TW223_STEP(rs, z, r) \
+  TW223_GEN(rs, z, r, 0, 63, 31, 18) \
+  TW223_GEN(rs, z, r, 1, 58, 19, 28) \
+  TW223_GEN(rs, z, r, 2, 55, 24,  7) \
+  TW223_GEN(rs, z, r, 3, 47, 21,  8)
+
+static uint64_t prng_u64 (PRNGState *rs) {
+  uint64_t z, r = 0;
+  TW223_STEP(rs, z, r)
+  return r;
+}
+
+static void random_seed (PRNGState *rs, double d) {
+  uint32_t r = 0x11090601;  /* 64-k[i] as four 8 bit constants. */
+  int i;
+  for (i = 0; i < 4; i++) {
+    U64double u;
+    uint32_t m = 1u << (r&255);
+    r >>= 8;
+    u.d = d = d * 3.14159265358979323846 + 2.7182818284590452354;
+    if (u.u64 < m) u.u64 += m;  /* Ensure k[i] MSB of u[i] are non-zero. */
+    rs->u[i] = u.u64;
+  }
+  for (i = 0; i < 10; i++)
+    (void)prng_u64(rs);
+}
