+/* Lua 5.2 / LuaJIT package.searchpath(name, path [, sep [, rep]]) */
+static int ll_searchpath (lua_State *L) {
+  const char *name = luaL_checkstring(L, 1);
+  const char *path = luaL_checkstring(L, 2);
+  const char *sep = luaL_optstring(L, 3, ".");
+  const char *rep = luaL_optstring(L, 4, LUA_DIRSEP);
+  if (*sep != '\0')
+    name = luaL_gsub(L, name, sep, rep);
+  lua_pushliteral(L, "");  /* error message accumulator */
+  while ((path = pushnexttemplate(L, path)) != NULL) {
+    const char *filename = luaL_gsub(L, lua_tostring(L, -1), LUA_PATH_MARK, name);
+    lua_remove(L, -2);  /* remove path template */
+    if (readable(filename))
+      return 1;  /* return that file name */
+    lua_pushfstring(L, "\n\tno file " LUA_QS, filename);
+    lua_remove(L, -2);  /* remove file name */
+    lua_concat(L, 2);  /* add entry to the accumulated message */
+  }
+  lua_pushnil(L);
+  lua_insert(L, -2);  /* nil, error message */
+  return 2;
+}
+
+
 static const luaL_Reg pk_funcs[] = {
   {"loadlib", ll_loadlib},
+  {"searchpath", ll_searchpath},
   {"seeall", ll_seeall},
   {NULL, NULL}
 };
