--- a/src/lvm.c
+++ b/src/lvm.c
@@ -357,6 +357,12 @@
 
 #define dojump(L,pc,i)	{(pc) += (i); luai_threadyield(L);}
 
+/* take the OP_JMP at pc; a nonzero A field closes upvalues from
+** base+A-1 up (Lua 5.2 semantics, used by goto) */
+#define donextjump(L,pc) { Instruction ji = *(pc); \
+	if (GETARG_A(ji)) luaF_close(L, base + GETARG_A(ji) - 1); \
+	dojump(L, pc, GETARG_sBx(ji)); }
+
 
 #define Protect(x)	{ L->savedpc = pc; {x;}; base = L->base; }
 
