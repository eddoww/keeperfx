+/* LuaJIT/5.2-compatible load(chunk [, chunkname [, mode [, env]]]):
+** chunk may be a string or a reader function; mode restricts binary ("b")
+** or text ("t") chunks; env becomes the loaded function's environment. */
 static int luaB_load (lua_State *L) {
   int status;
-  const char *cname = luaL_optstring(L, 2, "=(load)");
-  luaL_checktype(L, 1, LUA_TFUNCTION);
-  lua_settop(L, 3);  /* function, eventual name, plus one reserved slot */
-  status = lua_load(L, generic_reader, NULL, cname);
+  size_t l;
+  const char *s = lua_tolstring(L, 1, &l);
+  const char *mode = luaL_optstring(L, 3, "bt");
+  int envidx = lua_isnone(L, 4) ? 0 : 4;
+  if (s != NULL) {
+    const char *cname = luaL_optstring(L, 2, s);
+    int binary = (l > 0 && s[0] == LUA_SIGNATURE[0]);
+    if ((binary && strchr(mode, 'b') == NULL) || (!binary && strchr(mode, 't') == NULL)) {
+      lua_pushnil(L);
+      lua_pushfstring(L, "attempt to load a %s chunk (mode is '%s')",
+                      binary ? "binary" : "text", mode);
+      return 2;
+    }
+    status = luaL_loadbuffer(L, s, l, cname);
+  }
+  else {
+    const char *cname = luaL_optstring(L, 2, "=(load)");
+    luaL_checktype(L, 1, LUA_TFUNCTION);
+    /* function, name, reserved slot 3 (holds mode, overwritten by the
+    ** reader), and env in slot 4 when given */
+    lua_settop(L, envidx ? 4 : 3);
+    status = lua_load(L, generic_reader, NULL, cname);
+  }
+  if (status == 0 && envidx) {
+    lua_pushvalue(L, envidx);
+    lua_setfenv(L, -2);
+  }
   return load_aux(L, status);
 }
 
