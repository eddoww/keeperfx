// Cloudflare Worker for the browser build: serves the static site
// (build-web/site) and the /api for accounts, lobbies and the multiplayer
// relay. See docs/web.md, "Online play".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keeperfx",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // keeper.edwindejong.net is this Worker's custom domain (Cloudflare makes its DNS record).
  "routes": [
    { "pattern": "keeper.edwindejong.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../build-web/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/site.json", "/builds/*", "/data/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "keeperfx", "database_id": "a48ddbde-2ea5-4a8d-b166-4788fcd7484c", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "TAVERN", "class_name": "Tavern" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Tavern"] }
  ],
  "r2_buckets": [
    // Game data (gamedata/), uploaded with web/upload-r2.sh, served to players
    // from the bucket's public domain (DATA_URL below), not through the Worker.
    // Published replays are kept here too, under replays/ (src/replays.js).
    { "binding": "DATA", "bucket_name": "keeperfx-data" },
    // Workshop downloads kept after their first fetch from keeperfx.net
    // (src/workshop.js). Private: never give this bucket a public domain.
    { "binding": "WORKSHOP", "bucket_name": "keeperfx-workshop" },
    // Cloud saves of signed-in players (src/saves.js). Private: no public
    // domain, read only through /api/saves. Create once with
    // `npx wrangler r2 bucket create keeperfx-saves`.
    { "binding": "SAVES", "bucket_name": "keeperfx-saves" }
  ],
  "vars": {
    // Where the page downloads game data from. Empty: gamedata/ next to the page.
    // After `web/upload-r2.sh`, set it to "https://keeper-data.edwindejong.net/gamedata/".
    "DATA_URL": "",
    // "off" removes the offline app's service worker from players' browsers
    // (kill switch, see docs/web.md "App and offline play"); normally "on".
    "SERVICE_WORKER": "on",
    // Engine builds (web/publish-build.py, web/upload-builds.sh). BUILDS_FROM "r2":
    // the Worker serves /builds/ and /data/ from the DATA bucket; otherwise from the
    // static site (if it has them). BUILDS_URL, if set, sends the page straight to
    // the bucket's public domain instead (no Worker requests), e.g.
    // "https://keeper-data.edwindejong.net/builds/". Empty both: one engine next to the page.
    "BUILDS_FROM": "",
    "BUILDS_URL": "",
    // The tavern chat on the site: "off" closes it (news lines stay).
    "CHAT": "on",
    // Account names, comma separated, that may remove tavern lines and mute players.
    "ADMIN_USERS": "Vevionez",
    // Published replays (src/replays.js): largest file, per keeper count and
    // space, uploads per keeper per hour, and space for all replays together.
    "REPLAY_MAX_MB": "8",
    "REPLAY_MAX_PER_USER": "40",
    "REPLAY_USER_MB": "64",
    "REPLAY_PER_HOUR": "12",
    "REPLAY_TOTAL_MB": "4096",
    // Set DISCORD_CLIENT_ID here and DISCORD_CLIENT_SECRET with
    // `wrangler secret put` to enable "Sign in with Discord".
    "DISCORD_CLIENT_ID": "1569473036711628843"
  }
}
