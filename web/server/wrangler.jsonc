// Cloudflare Worker for the browser build: serves the static site
// (build-web/site) and the /api for accounts, lobbies and the multiplayer
// relay. See docs/web.md, "Online play".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keeperfx",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // keeper.edwindejong.net is this Worker's custom domain (Cloudflare makes its DNS record).
  "routes": [
    { "pattern": "keeper.edwindejong.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../build-web/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/site.json"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "keeperfx", "database_id": "a48ddbde-2ea5-4a8d-b166-4788fcd7484c", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "TAVERN", "class_name": "Tavern" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Tavern"] }
  ],
  "r2_buckets": [
    // Game data (gamedata/), uploaded with web/upload-r2.sh, served to players
    // from the bucket's public domain (DATA_URL below), not through the Worker.
    { "binding": "DATA", "bucket_name": "keeperfx-data" },
    // Workshop downloads kept after their first fetch from keeperfx.net
    // (src/workshop.js). Private: never give this bucket a public domain.
    { "binding": "WORKSHOP", "bucket_name": "keeperfx-workshop" }
  ],
  "vars": {
    // Where the page downloads game data from. Empty: gamedata/ next to the page.
    // After `web/upload-r2.sh`, set it to "https://keeper-data.edwindejong.net/gamedata/".
    "DATA_URL": "",
    // The tavern chat on the site: "off" closes it (news lines stay).
    "CHAT": "on",
    // Account names, comma separated, that may remove tavern lines and mute players.
    "ADMIN_USERS": "",
    // Set DISCORD_CLIENT_ID here and DISCORD_CLIENT_SECRET with
    // `wrangler secret put` to enable "Sign in with Discord".
    "DISCORD_CLIENT_ID": "1569473036711628843"
  }
}
